{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@rogue/core": ["./src/core/index.ts"]
    }
  },
  "include": ["src", "tests", "vite.config.ts", "playwright.config.ts"],
  // Lot 0 : la spec du moteur attend l'API du lot 1 ; elle rejoint la compilation avec le moteur.
  "exclude": ["tests/core.engine.spec.ts"]
}
